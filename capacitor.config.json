{
  "appId": "com.aura.assistant.ai",
  "appName": "Aura Assistant",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0F172A",
      "showSpinner": true,
      "androidSpinnerStyle": "large"
    }
  }
}
